{
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:AIService\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:AIService": "cd AIService && python manage.py runserver"
  }
}
